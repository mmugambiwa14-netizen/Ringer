{
  "name": "ringer",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --no-warnings --import ./tools/loader.mjs --test \"src/**/__tests__/**/*.test.ts\"",
    "test:watch": "node --no-warnings --import ./tools/loader.mjs --test --watch \"src/**/__tests__/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json}\"",
    "bundle": "expo export --platform ios --output-dir .expo-export",
    "check": "node tools/check-imports.mjs && node tools/check-hooks.mjs && node tools/check-jsx.mjs",
    "verify": "npm run content:check && npm run check && npm test",
    "content": "node tools/build-packs.mjs",
    "content:check": "node tools/build-packs.mjs --check",
    "sfx": "python3 tools/make-sfx.py",
    "icons": "python3 tools/make-icons.py",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json}\""
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.2.3",
    "@expo-google-fonts/archivo-black": "^0.2.3",
    "@expo-google-fonts/space-mono": "^0.2.3",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-audio": "~0.4.8",
    "expo-font": "~13.3.0",
    "expo-haptics": "~14.1.4",
    "expo-keep-awake": "~14.1.4",
    "expo-router": "~5.0.0",
    "expo-splash-screen": "~0.30.0",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "eslint": "^9.24.0",
    "eslint-config-expo": "~9.2.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3"
  }
}
